# Aplicação
NEXT_PUBLIC_APP_URL=https://www.adhdautism.online/brinqueteando
NEXT_PUBLIC_BASE_PATH=/brinqueteando

# Clerk
# Use as chaves de teste no ambiente local e as chaves live somente na produção.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_substitua
CLERK_SECRET_KEY=sk_test_substitua
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/brinqueteando
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/brinqueteando

# Stripe
STRIPE_SECRET_KEY=sk_test_substitua
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_substitua
STRIPE_WEBHOOK_SECRET=whsec_substitua
# Tarifa nacional provisória usada quando a integração contratual dos Correios não está ativa.
SHIPPING_FEE_CENTS=1990

# Correios — necessário contrato comercial com API Preços e API Prazos liberadas
CORREIOS_USERNAME=substitua_login_meu_correios
CORREIOS_API_CODE=substitua_codigo_de_acesso_api
CORREIOS_POSTING_CARD=substitua_cartao_postagem
CORREIOS_CONTRACT=substitua_numero_contrato
CORREIOS_DR=substitua_dr
CORREIOS_ORIGIN_CEP=11000000
# PAC e SEDEX contratados; ajuste conforme os serviços habilitados no contrato.
CORREIOS_SERVICE_CODES=03298,03220

# Resend
RESEND_API_KEY=re_substitua
RESEND_FROM_EMAIL=BrinqueTEAndo <pedidos@adhdautism.online>

# Cloudflare R2
CLOUDFLARE_API_TOKEN=cfat_substitua
R2_ACCOUNT_ID=substitua
R2_BUCKET_NAME=brinqueteando
R2_ACCESS_KEY_ID=substitua
R2_SECRET_ACCESS_KEY=substitua
R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://arquivos.adhdautism.online

# IDs do Clerk autorizados a enviar imagens ao R2, separados por vírgula
ADMIN_CLERK_USER_IDS=user_substitua

# Store Connector — token de autenticação para sync de estoque e rastreamento
STORE_CONNECTOR_SYNC_TOKEN=substitua
